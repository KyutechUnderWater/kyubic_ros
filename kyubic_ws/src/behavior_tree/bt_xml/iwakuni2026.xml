<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
  main_tree_to_execute="MainTree">
  <BehaviorTree ID="BlueROV2Auto">
    <!--
      ====================================================================
      BlueROV2Auto — iwakuni2026 大会用 自動ミッション本体
      ====================================================================
      呼び出し元: MainTree → SubTree(BlueROV2Auto)

      設計方針:
        - 移動は全て「1点CSVを書く → WaypointAction(PDLA)」に統一
        - 独自に WrenchPlan を出し続けるノード(GoToDepth 等)は使わない
        - 詳細: bluerov_control_bt_nodes/README.md §10

      座標の読み方 (WriteAxisOverrideWaypointCSV / CSV の z 列):
        z_mode="depth"(既定)     → z_depth 基準。正=下。水面からの水深[m]
        z_mode="altitude"        → z_altitude 基準。正=上。水底からの高度[m]
        静的 CSV(path_planner/assets/iwakuni/*.csv)は z_mode=0(depth)で人が微調整
        XML内の override は既定 depth。pinger_final_descend のみ altitude

      よく使う BT パターン:
        Fallback       → 第1子が SUCCESS なら終了、FAILURE なら第2子へ
        Timeout        → 子が制限時間内に終わらないと FAILURE
        RetryUntilSuccessful + AlwaysFailure → 子を繰り返し再試行
        Inverter       → 子の SUCCESS/FAILURE を反転

      前提トピック / ノード:
        - /localization/odom (localization)
        - pinger_direction (別ラズパイ sbl_control、音響追跡時)
        - /buoy/relative_position (buoy_detector、ビジョン時)
        - planner/pdla_planner/pdla_plan (WaypointAction)
        - planner/wrench_planner (ZOH、LifecycleManager で activate)

      全体の流れ:
        1. 初期化(localization リセット・ZOH 起動)
        1.5. 初回移動直前に IMU ヨー/姿勢ゼロ点リセット(現在の向き=yaw 0)
        2. 初期位置 (5,0,5) へ一気に移動(initial_dive_505.csv、z_mode=0 depth)
        [3] ハイドロフォン追跡(0.5m ずつ、pinger_direction 方向へステップ)
        十分近い判定は CheckPingerPitch(pitch≤50°、要実機検証)のみ。
        4. 最終潜航(水底からの高度。pinger_final_descend のみ z_mode=altitude)
        5. FindPingerAction(視覚捕捉)
        6. ビジョン突撃→復帰のあと [3] ハイドロ追跡へ戻る(ピンガー上から検出でサイクル終了)
        7. (7分タイムアウト時は停止位置へ退避)
        8. 復路(return_step1 / return_final)
    -->
    <Sequence name="AutoSequence">
      <Delay delay_msec="10">
        <Talker name="WaitTalker"
          message="Waiting before mission stack reset..."
          topic_name="/talker" />
      </Delay>
      <!-- [1. 初期化] 前回ミッションの残状態をクリアしてから制御を有効化 -->
      <Talker name="AutomatickTalker"
        message="Mission stack reset start"
        topic_name="/talker" />
      <Sequence name="MissionStackReset">
        <AbortPdlaGoal
          service_name="/planner/pdla_planner/abort_active_goal"
          timeout_sec="2.0" />
        <!-- ZOH が inactive(未 activate) のとき deactivate は invalid。失敗時はスキップして続行 -->
        <Fallback name="DeactivateZOHForResetOrSkip">
          <LifecycleManager name="DeactivateZOHForReset"
            node_name="planner/wrench_planner/zoh_wrench_planner_component"
            transition="deactivate"
            timeout_sec="3" />
          <Talker name="DeactivateZOHSkippedTalker"
            message="DeactivateZOH skipped (ZOH not active)"
            topic_name="/talker" />
        </Fallback>
        <ResetLocalization service_name="/localization/reset" timeout_sec="2.0" />
        <PublishWrenchPlanReset
          topic_name="/planner/wrench_planner/goal_current_odom"
          reset_mask="31" />
        <LifecycleManager name="ActivateZOHNode"
          node_name="planner/wrench_planner/zoh_wrench_planner_component"
          transition="activate"
          timeout_sec="3" />
      </Sequence>
      <Talker name="AutomatickTalker"
        message="Automatick Mode Start"
        topic_name="/talker" />

      <!--
        [2-7] ミッション本体 (7分タイムアウト付き)
        Fallback(MissionCoreOrSevenMinTimeout):
          第1子: Timeout(420000ms = 7分) で包んだ MissionCore
          第2子: SevenMinTimeoutTo11009 (時間切れ時の退避)
        7分以内に MissionCore が完了しないと Timeout が FAILURE を返し、
        Fallback が第2子(停止ウェイポイントへ移動)を実行する。
      -->
      <Fallback name="MissionCoreOrSevenMinTimeout">
        <Timeout msec="420000">
          <Sequence name="MissionCore">

      <!-- [2] 初期位置 (5,0,5) へ一気に移動。z_mode=0 は depth(水面から水深5m) -->
      <!-- 座標は path_planner/assets/iwakuni/initial_dive_505.csv で微調整 -->
      <!--
        [1.5] 進行方向を向いた状態でヨー/姿勢のゼロ点を確定。
        MissionStackReset の ResetLocalization でも IMU はリセットされるが、
        その後の ZOH activate 等の待ち時間で機体の向きが変わる可能性があるため、
        初回 WaypointAction の直前にもう一度 imu_transform の reset を呼ぶ。
        リードスイッチ発火後〜ここまでの間に進行方向へ機体を向けておくこと。
      -->
      <Talker name="ResetImuHeadingTalker"
        message="Reset IMU heading: current vehicle orientation = yaw 0"
        topic_name="/talker" />
      <CallTriggerService name="ResetImuTransform"
        service_name="/localization/imu/reset"
        timeout_sec="2.0" />
      <Talker name="AutomatickTalker"
        message="Initial Dive To 5,0,5 Start"
        topic_name="/talker" />
      <WaypointAction action_name="planner/pdla_planner/pdla_plan"
        csv_file_path="assets/sample/handytest.csv" />
      <Talker name="AutomatickTalker"
        message="Initial Dive To 5,0,5 Successful"
        topic_name="/talker" />

      <!--
        [3-6] ピンガー探索サイクル
        音響追跡(3)→潜航(4)→視覚(5,6)→復帰(6c)のあと、
        pitch>70°(上から)なら停止してサイクル終了→復路(8)へ。
        それ以外は AlwaysFailure で [3] ハイドロ追跡へ戻りピンガーを再探索。
      -->
      <RetryUntilSuccessful num_attempts="-1">
        <Sequence name="PingerVisionCycle">

      <!--
        [3] ハイドロフォン追跡ループ
        RetryUntilSuccessful(-1) + Fallback(PingerCloseOrStep):
          第1子: CheckPingerPitch(50°) → 十分近い → SUCCESS でループ脱出
          第2子 PingerStepAndRetry: pinger_direction へ 0.5m 前進 → AlwaysFailure で親を再試行
        WriteHydrophoneWaypointCSV は Z_MODE_DEPTH(水深基準)固定。
        pinger_direction は bluerov_bt.launch.py で remap。
      -->
      <Talker name="AutomatickTalker"
        message="Pinger Chase Start"
        topic_name="/talker" />
      <RetryUntilSuccessful num_attempts="-1">
        <Fallback name="PingerCloseOrStep">
          <CheckPingerPitch pitch_threshold_deg="50.0" />
          <Sequence name="PingerStepAndRetry">
            <WriteHydrophoneWaypointCSV
              odom_topic_name="odom"
              step_distance_m="0.5"
              csv_file_path="assets/iwakuni/hydrophone_step.csv" />
            <WaypointAction
              action_name="planner/pdla_planner/pdla_plan"
              csv_file_path="assets/iwakuni/hydrophone_step.csv" />
            <AlwaysFailure />
          </Sequence>
        </Fallback>
      </RetryUntilSuccessful>
      <Talker name="AutomatickTalker"
        message="Pinger Close Enough"
        topic_name="/talker" />

      <!--
        [4] 最終潜航
        x/y/roll/yaw は現在値維持。z だけ override。
        z_mode="altitude": 水底から override_z[m] の高度へ。
        注意: override_z="1.0" (要実測調整)
      -->
      <Talker name="AutomatickTalker"
        message="Final Descend Start"
        topic_name="/talker" />
      <WriteAxisOverrideWaypointCSV
        odom_topic_name="odom"
        override_z="6.5"
        z_mode="altitude"
        csv_file_path="assets/iwakuni/pinger_final_descend.csv" />
      <WaypointAction
        action_name="planner/pdla_planner/pdla_plan"
        csv_file_path="assets/iwakuni/pinger_final_descend.csv" />
      <Talker name="AutomatickTalker"
        message="Final Descend Successful, Handing off to Vision"
        topic_name="/talker" />

      <!-- [5. 視覚捕捉] -->
      <!-- FindPingerAction: 画像処理でピンガー(ブイ)を検出するまで待機 -->
      <FindPingerAction action_name="find_pinger" />

      <!--
        [6] ビジョン突撃フェーズ
        6a: CheckBuoyInFrame で画角にブイが入るまで無限待ち
        6b: CenteringOrFinalApproach ループ(最大3分)
             第1子 FinalApproach: 十分近い → 突撃 waypoint
             第2子 CenteringStep: 画像中心へ1歩 → AlwaysFailure で再試行
        6c: 復帰位置へ移動
        6d: pitch>70°でサイクル終了、それ以外は [3] へ戻る
      -->
      <Talker name="AutomatickTalker"
        message="Vision Collision Phase Start"
        topic_name="/talker" />

      <!-- 6a: ブイが画角に入るまで待つ -->
      <Talker name="AutomatickTalker"
        message="Vision Collision Start"
        topic_name="/talker" />
      <RetryUntilSuccessful num_attempts="-1">
        <CheckBuoyInFrame confidence_threshold="0.5" />
      </RetryUntilSuccessful>

      <!-- 6b: 中心合わせ or 最終突撃 (Timeout 180000ms = 3分で打ち切り) -->
      <Timeout msec="360000"> <!-- 6分 -->
        <RetryUntilSuccessful num_attempts="-1">
          <Fallback name="CenteringOrFinalApproach">
            <!-- ブイに十分近い: CheckBuoyPosition が target_x/y/z をブラックボードへ出力 -->
            <Sequence name="FinalApproach">
              <CheckBuoyPosition
                odom_topic_name="odom" target_x="{target_x}" target_y="{target_y}" target_z="{target_z}" />
              <WriteAxisOverrideWaypointCSV odom_topic_name="odom"
                override_x="{target_x}" override_y="{target_y}" override_z="{target_z}"
                csv_file_path="assets/iwakuni/buoy_approach.csv" />
              <WaypointAction action_name="planner/pdla_planner/pdla_plan"
                csv_file_path="assets/iwakuni/buoy_approach.csv" />
            </Sequence>
            <!-- まだ遠い: 画像中心へ1歩進んでループ継続 -->
            <Sequence name="CenteringStep">
              <WriteVisionWaypointCSV
                odom_topic_name="odom" csv_file_path="assets/iwakuni/vision_step.csv" />
              <WaypointAction action_name="planner/pdla_planner/pdla_plan"
                csv_file_path="assets/iwakuni/vision_step.csv" />
              <AlwaysFailure />
            </Sequence>
          </Fallback>
        </RetryUntilSuccessful>
      </Timeout>

      <!-- 6c: 復帰ホールド位置へ (override_z=6.0 は既定 depth=水深6m) -->
      <Talker name="AutomatickTalker"
        message="Return To Hold Position 12,50,50"
        topic_name="/talker" />
      <WriteAxisOverrideWaypointCSV
        odom_topic_name="odom"
        override_x="9.0"
        override_y="0.0"
        override_z="6.0"
        csv_file_path="assets/iwakuni/return_hold_9005.csv" />
      <WaypointAction
        action_name="planner/pdla_planner/pdla_plan"
        csv_file_path="assets/iwakuni/return_hold_9005.csv" />

      <!--
        [6d] サイクル終了 or [3] へ戻る
        Fallback(ExitCycleOrChaseAgain):
          第1子: pitch>70°(上から) → 停止位置へ → SUCCESS でサイクル脱出
          第2子: AlwaysFailure → 親 RetryUntilSuccessful が [3] から再実行
      -->
      <Talker name="AutomatickTalker"
        message="Hydrophone Pitch Branch"
        topic_name="/talker" />
      <Fallback name="ExitCycleOrChaseAgain">
        <!--
          Inverter + CheckPingerPitch(70°):
            pitch>70°(上から)のとき SUCCESS → 停止してサイクル終了
        -->
        <Sequence name="PingerFromAboveStop">
          <Inverter>
            <CheckPingerPitch pitch_threshold_deg="70.0" />
          </Inverter>
          <Talker name="AutomatickTalker"
            message="Pinger From Above, Stop at 11,0,10"
            topic_name="/talker" />
          <WriteAxisOverrideWaypointCSV
            odom_topic_name="odom"
            override_x="9.0"
            override_y="0.0"
            override_z="6.0"
            csv_file_path="assets/iwakuni/stop_11009.csv" />
          <WaypointAction
            action_name="planner/pdla_planner/pdla_plan"
            csv_file_path="assets/iwakuni/stop_11009.csv" />
        </Sequence>

        <!-- 上からでない → [3] ハイドロ追跡へ戻ってピンガーを再探索 -->
        <Sequence name="ReturnToHydrophoneChase">
          <Talker name="AutomatickTalker"
            message="Pinger Not From Above, Return To Hydrophone Chase"
            topic_name="/talker" />
          <AlwaysFailure />
        </Sequence>
      </Fallback>

        </Sequence><!-- PingerVisionCycle -->
      </RetryUntilSuccessful>
      <Talker name="AutomatickTalker"
        message="Pinger Vision Cycle Complete"
        topic_name="/talker" />

          </Sequence><!-- MissionCore 終了 -->
        </Timeout><!-- 7分タイムアウト -->

        <!--
          [7分タイムアウト時の退避] MissionCoreOrSevenMinTimeout の第2子
          MissionCore が 420000ms 内に終わらなかったときのみ実行。
          Talker は「9,0,6」だが override は (9,0,6.5) depth。要実測調整。
        -->
        <Sequence name="SevenMinTimeoutTo11009">
          <Talker name="AutomatickTalker"
            message="7 Minute Timeout From Startup, Stop at 11,0,9"
            topic_name="/talker" />
          <WriteAxisOverrideWaypointCSV
            odom_topic_name="odom"
            override_x="9.0"
            override_y="0.0"
            override_z="6.5"
            csv_file_path="assets/iwakuni/stop_11009.csv" />
          <WaypointAction
            action_name="planner/pdla_planner/pdla_plan"
            csv_file_path="assets/iwakuni/stop_11009.csv" />
        </Sequence>
      </Fallback><!-- MissionCoreOrSevenMinTimeout 終了 -->

      <!--
        [8a] 復路ステップ1
        x だけ 9.0m, z だけ 5.0m へ。y/roll/yaw は WriteAxisOverrideWaypointCSV が現在 odom から維持。
      -->
      <Talker name="AutomatickTalker"
        message="Return Step 1 Start"
        topic_name="/talker" />
      <WriteAxisOverrideWaypointCSV
        odom_topic_name="odom"
        override_x="9.0"
        override_y="0.0"
        override_z="5.0"
        csv_file_path="assets/iwakuni/return_step1.csv" />
      <WaypointAction
        action_name="planner/pdla_planner/pdla_plan"
        csv_file_path="assets/iwakuni/return_step1.csv" />

      <!-- [8b. 復路ステップ2] -->
      <!-- 静的 CSV return_final.csv で帰還完了地点まで移動(要実測座標記入) -->
      <Talker name="AutomatickTalker"
        message="Return Step 2 Start"
        topic_name="/talker" />
      <WaypointAction
        action_name="planner/pdla_planner/pdla_plan"
        csv_file_path="assets/iwakuni/return_final.csv" />
      <Talker name="AutomatickTalker"
        message="Return Successful"
        topic_name="/talker" />

      <!-- ミッション完了。ツリーを RUNNING で維持(自動復帰・再実行はしない) -->
      <AlwaysRunning name="AutoRunning" />
    </Sequence>
  </BehaviorTree>

  <!--
    ====================================================================
    Configure — 起動準備
    ====================================================================
    MainTree の先頭で一度だけ呼ばれる。
    wrench_planner(ZOH) と emergencyNode を configure 状態にする。
    selected_course ブラックボードを "B" に設定(現状ミッション分岐には未使用)。
  -->
  <BehaviorTree ID="Configure">
    <Delay delay_msec="2000">
      <Sequence name="ConfigureSequence">
        <SetBlackboard value="B"
          output_key="selected_course" />
        <LifecycleManager name="ConfigureZOHNode"
          node_name="planner/wrench_planner/zoh_wrench_planner_component"
          transition="configure"
          timeout_sec="3" />
        <LifecycleManager name="ConfigureEmergencyNode"
          node_name="emergencyNode"
          transition="configure"
          timeout_sec="3" />
      </Sequence>
    </Delay>
  </BehaviorTree>

  <!--
    ====================================================================
    Emergency — 緊急浮上
    ====================================================================
    CheckSensorsStatus 失敗等で MainTree の Fallback から呼ばれる。
    ZOH(通常推力)を deactivate → emergencyNode を activate → 緊急浮上。
    AlwaysRunning で居座り続ける(この機体では自動復帰しない)。
  -->
  <BehaviorTree ID="Emergency">
    <Sequence name="EmergencySequence">
      <Fallback name="DeactivateZOHOrSkip">
        <LifecycleManager name="DeactivateZOHNode"
          node_name="planner/wrench_planner/zoh_wrench_planner_component"
          transition="deactivate"
          timeout_sec="3" />
        <Talker name="EmergencyDeactivateZOHSkippedTalker"
          message="Emergency: DeactivateZOH skipped (ZOH not active)"
          topic_name="/talker" />
      </Fallback>
      <Talker name="EmergencyTalker"
        message="Emergency Mode Start"
        topic_name="/talker" />
      <LifecycleManager name="ActivateEmergencyNode"
        node_name="emergencyNode"
        transition="activate"
        timeout_sec="3" />
      <AlwaysRunning name="EmergencyRunning" />
    </Sequence>
  </BehaviorTree>

  <!--
    ====================================================================
    MainTree — エントリーポイント (main_tree_to_execute)
    ====================================================================
    起動: reed_switch 発火後(bt_executor wait_for_trigger=true)
    流れ:
      2秒待機 → BatteryCheck
      → Fallback:
          第1子: Configure → センサー確認(最大10回) → BlueROV2Auto
          第2子: Emergency
    CheckSensorsStatus: imu/depth/dvl/leak の OR 判定(1つでも正常なら SUCCESS)
  -->
  <BehaviorTree ID="MainTree">
    <Delay delay_msec="2000">
      <Sequence>
        <BatteryCheck />
        <Fallback>
          <Sequence>
            <SubTree ID="Configure" selected_course="{selected_course}" />
            <RetryUntilSuccessful num_attempts="10">
              <CheckSensorsStatus leak="{leak}" />
            </RetryUntilSuccessful>
            <SubTree ID="BlueROV2Auto" selected_course="{selected_course}" />
          </Sequence>
          <SubTree ID="Emergency" />
        </Fallback>
      </Sequence>
    </Delay>
  </BehaviorTree>

  <!-- Groot 用ノード定義(エディタ表示・ポート一覧) -->
  <TreeNodesModel>
    <Action ID="AlwaysRunning"
      editable="true" />
    <Action ID="BatteryCheck"
      editable="true" />
    <Action ID="CheckSensorsStatus"
      editable="true">
      <output_port name="leak" />
    </Action>
    <Action ID="FindPingerAction" editable="true">
      <input_port name="action_name" default="find_pinger" />
    </Action>
    <Action ID="LifecycleManager"
      editable="true">
      <input_port name="node_name" />
      <input_port name="transition" />
      <input_port name="timeout_sec" />
    </Action>
    <Action ID="AbortPdlaGoal" editable="true">
      <input_port name="service_name"
        default="/planner/pdla_planner/abort_active_goal" />
      <input_port name="timeout_sec" default="2.0" />
    </Action>
    <Action ID="CallTriggerService" editable="true">
      <input_port name="service_name" />
      <input_port name="timeout_sec" default="2.0" />
    </Action>
    <Action ID="PublishWrenchPlanReset" editable="true">
      <input_port name="topic_name"
        default="/planner/wrench_planner/goal_current_odom" />
      <input_port name="reset_mask" default="31" />
    </Action>
    <Action ID="ResetLocalization" editable="true">
      <input_port name="service_name" default="/localization/reset" />
      <input_port name="timeout_sec" default="1.0" />
    </Action>
    <Action ID="WaypointAction"
      editable="true">
      <input_port name="action_name"
        default="planner/pdla_planner/pdla_plan" />
      <input_port name="csv_file_path" />
    </Action>
    <Action ID="WriteAxisOverrideWaypointCSV" editable="true">
      <input_port name="odom_topic_name" default="odom" />
      <input_port name="override_x" />
      <input_port name="override_y" />
      <input_port name="override_z" />
      <input_port name="override_yaw" />
      <input_port name="z_mode" default="depth" />
      <input_port name="csv_file_path" />
    </Action>
    <Action ID="WritePingerWaypointCSV" editable="true">
      <input_port name="pinger_position_topic" default="pinger_position" />
      <input_port name="pinger_direction_topic" default="pinger_direction" />
      <input_port name="odom_topic_name" default="odom" />
      <input_port name="step_distance_m" default="0.5" />
      <input_port name="score_threshold" default="1000000.0" />
      <input_port name="csv_file_path" />
    </Action>
    <Action ID="WriteHydrophoneWaypointCSV" editable="true">
      <input_port name="pinger_direction_topic" default="pinger_direction" />
      <input_port name="odom_topic_name" default="odom" />
      <input_port name="step_distance_m" default="0.5" />
      <input_port name="csv_file_path" />
    </Action>
    <Condition ID="CheckBuoyInFrame" editable="true">
      <input_port name="confidence_threshold" default="0.5" />
      <input_port name="stale_timeout_sec" default="1.0" />
    </Condition>
    <Condition ID="CheckPingerRange" editable="true">
      <input_port name="pinger_position_topic" default="pinger_position" />
      <input_port name="odom_topic_name" default="odom" />
      <input_port name="range_threshold_m" default="1.0" />
      <input_port name="score_threshold" default="1000000.0" />
    </Condition>
    <Condition ID="CheckPingerPitch" editable="true">
      <input_port name="pinger_direction_topic" default="pinger_direction" />
      <input_port name="pitch_threshold_deg" default="50.0" />
    </Condition>
    <Action ID="CheckBuoyPosition" editable="true">
      <input_port name="odom_topic_name" default="odom" />
      <input_port name="confidence_threshold" default="0.5" />
      <input_port name="stale_timeout_sec" default="1.0" />
      <output_port name="target_x" />
      <output_port name="target_y" />
      <output_port name="target_z" />
    </Action>
    <Action ID="WriteVisionWaypointCSV" editable="true">
      <input_port name="odom_topic_name" default="odom" />
      <input_port name="step_distance_m" default="0.3" />
      <input_port name="vertical_gain_m" default="0.2" />
      <input_port name="deadband_rad" default="0.035" />
      <input_port name="horizontal_fov_rad" />
