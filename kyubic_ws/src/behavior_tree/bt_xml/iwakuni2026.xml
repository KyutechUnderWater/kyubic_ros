<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
  main_tree_to_execute="MainTree">
  <BehaviorTree ID="BlueROV2Auto">
    <Sequence name="AutoSequence">
      <Talker name="AutomatickTalker"
        message="Automatick Mode Start"
        topic_name="/talker" />
      <ResetLocalization service_name="/localization/reset" timeout_sec="2.0" />
      <LifecycleManager name="ActivateZOHNode"
        node_name="planner/wrench_planner/wrench_planner_component"
        transition="activate"
        timeout_sec="1" />
      <Talker name="AutomatickTalker"
        message="Waypoint Action Start"
        topic_name="/talker" />
      <WaypointAction action_name="planner/pdla_planner/pdla_plan"
        csv_file_path="assets/iwakuni/transit_shallow.csv" />
      <Talker name="AutomatickTalker"
        message="Waypoint Action Successful"
        topic_name="/talker" />
      <Talker name="AutomatickTalker"
        message="Descend Waypoint Start"
        topic_name="/talker" />
      <WaypointAction action_name="planner/pdla_planner/pdla_plan"
        csv_file_path="assets/iwakuni/descend_deep.csv" />
      <Talker name="AutomatickTalker"
        message="Descend Waypoint Successful"
        topic_name="/talker" />
      <Talker name="AutomatickTalker"
        message="Pinger Chase Start"
        topic_name="/talker" />
      <RetryUntilSuccessful num_attempts="-1">
        <Fallback name="PingerCloseOrStep">
          <CheckPingerPitch
            pinger_direction_topic="pinger_direction"
            pitch_threshold_deg="50.0" />
          <Sequence name="PingerStepAndRetry">
            <WriteHydrophoneWaypointCSV
              pinger_direction_topic="pinger_direction"
              odom_topic_name="odom"
              step_distance_m="0.5"
              csv_file_path="assets/iwakuni/hydrophone_step.csv" />
            <WaypointAction
              action_name="planner/pdla_planner/pdla_plan"
              csv_file_path="assets/iwakuni/hydrophone_step.csv" />
            <AlwaysFailure />
          </Sequence>
        </Fallback>
      </RetryUntilSuccessful>
      <Talker name="AutomatickTalker"
        message="Pinger Close Enough"
        topic_name="/talker" />
      <Talker name="AutomatickTalker"
        message="Final Descend Start"
        topic_name="/talker" />
      <WriteAxisOverrideWaypointCSV
        odom_topic_name="odom"
        override_z="2.5"
        z_mode="altitude"
        csv_file_path="assets/iwakuni/pinger_final_descend.csv" />
      <WaypointAction
        action_name="planner/pdla_planner/pdla_plan"
        csv_file_path="assets/iwakuni/pinger_final_descend.csv" />
      <Talker name="AutomatickTalker"
        message="Final Descend Successful, Handing off to Vision"
        topic_name="/talker" />
      <FindPingerAction action_name="find_pinger" />

      <Talker name="AutomatickTalker" message="Vision Approach Start" topic_name="/talker" />
      <Timeout msec="180000">
        <RetryUntilSuccessful num_attempts="-1">
          <Fallback name="CenteringOrFinalApproach">
            <Sequence name="FinalApproach">
              <CheckBuoyPosition buoy_relative_position_topic="/buoy/relative_position"
                odom_topic_name="odom" target_x="{target_x}" target_y="{target_y}" target_z="{target_z}" />
              <WriteAxisOverrideWaypointCSV odom_topic_name="odom"
                override_x="{target_x}" override_y="{target_y}" override_z="{target_z}"
                csv_file_path="assets/iwakuni/buoy_approach.csv" />
              <WaypointAction action_name="planner/pdla_planner/pdla_plan"
                csv_file_path="assets/iwakuni/buoy_approach.csv" />
            </Sequence>
            <Sequence name="CenteringStep">
              <WriteVisionWaypointCSV buoy_relative_position_topic="/buoy/relative_position"
                odom_topic_name="odom" csv_file_path="assets/iwakuni/vision_step.csv" />
              <WaypointAction action_name="planner/pdla_planner/pdla_plan"
                csv_file_path="assets/iwakuni/vision_step.csv" />
              <AlwaysFailure />
            </Sequence>
          </Fallback>
        </RetryUntilSuccessful>
      </Timeout>

      <Talker name="AutomatickTalker" message="Buoy Contact, Holding Position" topic_name="/talker" />
      <Delay delay_msec="10000" />

      <Talker name="AutomatickTalker" message="Release Check Start" topic_name="/talker" />
      <Timeout msec="30000">
        <RetryUntilSuccessful num_attempts="-1">
          <Sequence name="ReleaseConfirmed">
            <Inverter>
              <CheckPingerPitch pinger_direction_topic="pinger_direction" pitch_threshold_deg="70.0" />
            </Inverter>
            <Inverter>
              <CheckBuoyInFrame buoy_relative_position_topic="/buoy/relative_position"
                confidence_threshold="0.5" />
            </Inverter>
          </Sequence>
        </RetryUntilSuccessful>
      </Timeout>
      <Talker name="AutomatickTalker" message="Release Confirmed" topic_name="/talker" />

      <Talker name="AutomatickTalker"
        message="Return Step 1 Start"
        topic_name="/talker" />
      <WriteAxisOverrideWaypointCSV
        odom_topic_name="odom"
        override_x="11.0"
        csv_file_path="assets/iwakuni/return_step1.csv" />
      <WaypointAction
        action_name="planner/pdla_planner/pdla_plan"
        csv_file_path="assets/iwakuni/return_step1.csv" />
      <Talker name="AutomatickTalker"
        message="Return Step 2 Start"
        topic_name="/talker" />
      <WaypointAction
        action_name="planner/pdla_planner/pdla_plan"
        csv_file_path="assets/iwakuni/return_final.csv" />
      <Talker name="AutomatickTalker"
        message="Return Successful"
        topic_name="/talker" />
      <AlwaysRunning name="AutoRunning" />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Configure">
    <Delay delay_msec="2000">
      <Sequence name="ConfigureSequence">
        <SetBlackboard value="B"
          output_key="selected_course" />
        <LifecycleManager name="ConfigureManualNode"
          node_name="manualNode"
          transition="configure"
          timeout_sec="1" />
        <LifecycleManager name="ConfigureZOHNode"
          node_name="planner/wrench_planner/wrench_planner_component"
          transition="configure"
          timeout_sec="1" />
        <LifecycleManager name="ConfigureEmergencyNode"
          node_name="emergencyNode"
          transition="configure"
          timeout_sec="1" />
      </Sequence>
    </Delay>
  </BehaviorTree>

  <BehaviorTree ID="Emergency">
    <Sequence name="EmergencySequence">
      <LifecycleManager name="DeactivateZOHNode"
        node_name="planner/wrench_planner/wrench_planner_component"
        transition="deactivate"
        timeout_sec="1" />
      <Talker name="EmergencyTalker"
        message="Emergency Mode Start"
        topic_name="/talker" />
      <LifecycleManager name="ActivateEmergencyNode"
        node_name="emergencyNode"
        transition="activate"
        timeout_sec="1" />
      <AlwaysRunning name="EmergencyRunning" />
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <Delay delay_msec="2000">
      <Sequence>
        <BatteryCheck />
        <Fallback>
          <Sequence>
            <SubTree ID="Configure" selected_course="{selected_course}" />
            <ReactiveSequence>
              <RetryUntilSuccessful num_attempts="10">
                <CheckSensorsStatus leak="{leak}" />
              </RetryUntilSuccessful>
              <UpdateMode topic_name="/joy_common/joy_common"
                manual_button="circle"
                auto_button="cross"
                mode="{mode}" />
              <Switch2 name="mode_switch"
                variable="{mode}"
                case_1="manual"
                case_2="auto">
                <SubTree ID="Manual" />
                <SubTree ID="BlueROV2Auto" selected_course="{selected_course}" />
                <AlwaysFailure />
              </Switch2>
            </ReactiveSequence>
          </Sequence>
          <SubTree ID="Emergency" />
        </Fallback>
      </Sequence>
    </Delay>
  </BehaviorTree>

  <BehaviorTree ID="Manual">
    <Sequence name="ManualSequence">
      <Talker name="ManualTalker"
        message="Manual Mode Start"
        topic_name="/talker" />
      <LifecycleManager name="ActivateManualNode"
        node_name="manualNode"
        transition="activate"
        timeout_sec="1" />
      <AlwaysRunning name="ManualRunning" />
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AlwaysRunning"
      editable="true" />
    <Action ID="BatteryCheck"
      editable="true" />
    <Action ID="CheckSensorsStatus"
      editable="true">
      <output_port name="leak" />
    </Action>
    <Action ID="FindPingerAction" editable="true">
      <input_port name="action_name" default="find_pinger" />
    </Action>
    <Action ID="LifecycleManager"
      editable="true">
      <input_port name="node_name" />
      <input_port name="transition" />
      <input_port name="timeout_sec" />
    </Action>
    <Action ID="QrAction" editable="true">
      <input_port name="action_name" default="qr_action" />
    </Action>
    <Action ID="ResetLocalization" editable="true">
      <input_port name="service_name" default="/localization/reset" />
      <input_port name="timeout_sec" default="1.0" />
    </Action>
    <Action ID="UpdateMode"
      editable="true">
      <input_port name="topic_name" />
      <input_port name="manual_button" />
      <input_port name="auto_button" />
      <output_port name="mode" />
    </Action>
    <Action ID="WaypointAction"
      editable="true">
      <input_port name="action_name"
        default="planner/pdla_planner/pdla_plan" />
      <input_port name="csv_file_path" />
    </Action>
    <Action ID="WriteAxisOverrideWaypointCSV" editable="true">
      <input_port name="odom_topic_name" default="odom" />
      <input_port name="override_x" />
      <input_port name="override_y" />
      <input_port name="override_z" />
      <input_port name="override_yaw" />
      <input_port name="z_mode" default="depth" />
      <input_port name="csv_file_path" />
    </Action>
    <Action ID="WriteHydrophoneWaypointCSV" editable="true">
      <input_port name="pinger_direction_topic" default="pinger_direction" />
      <input_port name="odom_topic_name" default="odom" />
      <input_port name="step_distance_m" default="0.5" />
      <input_port name="csv_file_path" />
    </Action>
    <Condition ID="CheckBuoyInFrame" editable="true">
      <input_port name="buoy_relative_position_topic" default="/buoy/relative_position" />
      <input_port name="confidence_threshold" default="0.5" />
    </Condition>
    <Condition ID="CheckPingerPitch" editable="true">
      <input_port name="pinger_direction_topic" default="pinger_direction" />
      <input_port name="pitch_threshold_deg" default="50.0" />
    </Condition>
    <Action ID="CheckBuoyPosition" editable="true">
      <input_port name="buoy_relative_position_topic" default="/buoy/relative_position" />
      <input_port name="odom_topic_name" default="odom" />
      <input_port name="confidence_threshold" default="0.5" />
      <input_port name="stale_timeout_sec" default="1.0" />
      <output_port name="target_x" />
      <output_port name="target_y" />
      <output_port name="target_z" />
    </Action>
    <Action ID="WriteVisionWaypointCSV" editable="true">
      <input_port name="buoy_relative_position_topic" default="/buoy/relative_position" />
      <input_port name="odom_topic_name" default="odom" />
      <input_port name="step_distance_m" default="0.3" />
      <input_port name="vertical_gain_m" default="0.2" />
      <input_port name="deadband_rad" default="0.035" />
      <input_port name="horizontal_fov_rad" />
      <input_port name="confidence_threshold" default="0.5" />
      <input_port name="csv_file_path" />
    </Action>
  </TreeNodesModel>



</root>