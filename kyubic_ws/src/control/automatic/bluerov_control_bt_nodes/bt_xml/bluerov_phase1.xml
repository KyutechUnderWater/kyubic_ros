<?xml version="1.0" encoding="UTF-8"?>
<!--
BlueROV Phase 1: 最小構成のミッションツリー。

Kyubicのbt_xml/base.xmlと同じ構造(Configure/Auto/Emergency SubTree + MainTreeのFallback)を
踏襲しているが、Phase 1では以下を意図的に省略している(README参照):
  - Manual(joystick)モード切り替え、UpdateMode/Switch2
  - BatteryCheck/CheckSensorsStatus(Kyubicのバッテリー本数前提の閾値が
    BlueROVにそのまま使えるか未検証のため)
  - ハイドロフォン「発見」判定・VISUAL/HYDRO探索の分岐(Phase 2で追加予定)

Autoでは、SetDepthTarget(このパッケージのBT葉ノード)で1回だけ絶対深度目標を
zoh_wrench_planへpublishしたあとはAlwaysRunningで待機するのみ。水平方向の追従は、
別途 sbl_controller_node(音響班、未実装)が同じzoh_wrench_planへ継続的に
WrenchPlanをpublishする前提(README参照)。
-->
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="Configure">
    <Delay delay_msec="2000">
      <Sequence name="ConfigureSequence">
        <LifecycleManager name="ConfigureZOHNode"
                          node_name="planner/wrench_planner/zoh_wrench_planner_component"
                          transition="configure"
                          timeout_sec="1"/>
        <LifecycleManager name="ConfigureEmergencyNode"
                          node_name="emergencyNode"
                          transition="configure"
                          timeout_sec="1"/>
      </Sequence>
    </Delay>
  </BehaviorTree>

  <BehaviorTree ID="Auto">
    <Sequence name="AutoSequence">
      <LifecycleManager name="ActivateZOHNode"
                        node_name="planner/wrench_planner/zoh_wrench_planner_component"
                        transition="activate"
                        timeout_sec="1"/>
      <Talker name="AutoTalker"
              message="Descending to depth"
              topic_name="/talker"/>
      <SetDepthTarget depth_m="7.0"/>
      <AlwaysRunning name="AutoRunning"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Emergency">
    <Sequence name="EmergencySequence">
      <Fallback>
        <LifecycleManager name="DeactivateZOHNode"
                          node_name="planner/wrench_planner/zoh_wrench_planner_component"
                          transition="deactivate"
                          timeout_sec="1"/>
        <AlwaysSuccess/>
      </Fallback>
      <Talker name="EmergencyTalker"
              message="Emergency Mode Start"
              topic_name="/talker"/>
      <LifecycleManager name="ActivateEmergencyNode"
                        node_name="emergencyNode"
                        transition="activate"
                        timeout_sec="1"/>
      <AlwaysRunning name="EmergencyRunning"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <Delay delay_msec="2000">
      <Fallback name="MainFallback">
        <Sequence name="NormalSequence">
          <SubTree ID="Configure"/>
          <SubTree ID="Auto"/>
        </Sequence>
        <SubTree ID="Emergency"/>
      </Fallback>
    </Delay>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="SetDepthTarget"
            editable="true">
      <input_port name="depth_m"/>
      <input_port name="topic_name"
                  default="zoh_wrench_plan"/>
      <input_port name="odom_topic_name"
                  default="odom"/>
    </Action>
  </TreeNodesModel>

</root>
