<?xml version="1.0" encoding="UTF-8"?>
<!--
BlueROV Phase 2: 旧 bluerov_control/flow.py の17状態をすべてBT化したもの。

【ミッション定数の設定元】
  config/bluerov_mission.param.yaml (init_wait_sec, configure_delay_sec, search_timeout_sec,
  mic_confirm_timeout_sec, overall_mission_timeout_sec, origin_capture_timeout_sec,
  dive_offset_m, post_check_rise_offset_m, surface_rise_offset_m, descend_depth_m, field_size_m)
  → 起動時に <LoadMissionParams/> が ROS パラメータを読みブラックボードへ載せる。
  → 本 XML 内の {init_wait_ms} 等がそれを参照する。
  descend_depth_m は launch 引数 depth_target_m でも上書き可能(default_depth_m)。

【状態対応の要約(README参照)】
  INIT                              -> Delay {init_wait_ms} (param: init_wait_sec。旧180秒)
  DESCEND_TO_7M                     -> GoToDepth(ポート省略、default_depth_m / descend_depth_m)
  SEARCH_HYDROPHONE                 -> Timeout {search_timeout_ms} で CheckPingerFound
  発見後のVISUAL/HYDRO分岐           -> CheckRosBoolParam(debug.image_processing_available)
  VISUAL_DIVE..VISUAL_POST_CHECKループ -> VisualPath SubTree
  HOLD_TARGET..HYDRO_CHECK_MICループ  -> HydroPath SubTree
  SURFACE -> RETURN_HOME -> DONE     -> Surface SubTree (param: surface_rise_offset_m)
  EMERGENCY                          -> Emergency SubTree(Phase 1から変更なし)

【個別テスト】main_tree_idパラメータ(bt_executor.cpp、Phase 2で追加)で
MainTree以外のBehaviorTree IDを直接rootとして起動できる。例:
  ros2 launch bluerov_control_bt_nodes bluerov_bt.launch.py main_tree:=MainTree_VisualPath
README「個別テスト方法」参照。

【タイムアウトの考え方】search_timeout(7分)・mic_confirm_timeout(45秒)で主要な待機状態を
すべて束縛し、さらにAutoSequence全体を大枠のタイムアウト(overall_mission_timeout_sec、
既定500秒)で覆うことで「無限にRUNNINGし続ける状態」を作らないようにしている
(依頼書4節の安全要件2)。overall_mission_timeout_secはsearch_timeout_sec(420秒)より
必ず大きい値にすること: 内側のTimeout[CheckPingerFound]はAutoSequence内で
ActivateZOHNode/AutoTalker/DescendTo7mの分だけ外側より遅れて開始するため、
両者を同じ値にすると探索が内側の期限をほぼ使い切った場合に、内側が自前でSURFACEへ
落ちる前に外側がAutoSequence全体をFAILUREにしてしまい、本来SURFACEで終わるべき場面が
EMERGENCYになる。既定値500秒 = 420(search_timeout_sec) + 80(前段処理 +
VisualPath/HydroPathのmic_confirm_timeout_sec分の余裕)。
GoToDepth/GoToBlackboardTarget/CheckBuoyDetected/CaptureMissionOrigin自体は個別の
タイムアウトを持たないが、これらは必ずいずれかのTimeoutでラップされた区間の中でのみ
使われる(CaptureMissionOriginはorigin_capture_timeout_secでMainTree側から包む)。
-->
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">

  <!-- config/bluerov_mission.param.yaml → ブラックボード。各 SubTree の先頭で呼ぶ -->
  <BehaviorTree ID="InitMission">
    <LoadMissionParams name="LoadMissionParamsFromYaml"/>
  </BehaviorTree>

  <BehaviorTree ID="Configure">
    <!-- param: configure_delay_sec → {configure_delay_ms} (Lifecycle ノード起動の猶予) -->
    <Delay delay_msec="{configure_delay_ms}">
      <Sequence name="ConfigureSequence">
        <LifecycleManager name="ConfigureZOHNode"
                          node_name="planner/wrench_planner/zoh_wrench_planner_component"
                          transition="configure"
                          timeout_sec="1"/>
        <LifecycleManager name="ConfigureEmergencyNode"
                          node_name="emergencyNode"
                          transition="configure"
                          timeout_sec="1"/>
      </Sequence>
    </Delay>
  </BehaviorTree>

  <BehaviorTree ID="Emergency">
    <Sequence name="EmergencySequence">
      <Fallback>
        <LifecycleManager name="DeactivateZOHNode"
                          node_name="planner/wrench_planner/zoh_wrench_planner_component"
                          transition="deactivate"
                          timeout_sec="1"/>
        <AlwaysSuccess/>
      </Fallback>
      <Talker name="EmergencyTalker"
              message="Emergency Mode Start"
              topic_name="/talker"/>
      <LifecycleManager name="ActivateEmergencyNode"
                        node_name="emergencyNode"
                        transition="activate"
                        timeout_sec="1"/>
      <AlwaysRunning name="EmergencyRunning"/>
    </Sequence>
  </BehaviorTree>

  <!-- 旧VISUAL_DIVE(dive_offset_m) -> [VISUAL_CHECK_MIC/... ループ、mic_confirm_timeout_sec で束縛] -->
  <BehaviorTree ID="VisualPath">
    <Sequence name="VisualDive">
      <!-- param: dive_offset_m -->
      <GoToDepth name="VisualDiveStep" depth_offset_m="{dive_offset_m}"/>
      <Fallback name="MicConfirmedOrEmergency">
        <!-- param: mic_confirm_timeout_sec → {mic_confirm_timeout_ms} -->
        <Timeout msec="{mic_confirm_timeout_ms}">
          <RetryUntilSuccessful num_attempts="-1">
            <Fallback name="CheckMicOrAttack">
              <Sequence name="MicConfirmed">
                <CheckRosBoolParam param_name="debug.mic_data_from_above" default_value="false"/>
                <SubTree ID="Surface"/>
              </Sequence>
              <Sequence name="DetectAndAttack">
                <CheckBuoyDetected target_x="{target_x}" target_y="{target_y}" target_z="{target_z}"/>
                <GoToBlackboardTarget name="VisualAttack"
                                      target_x="{target_x}" target_y="{target_y}" target_z="{target_z}"
                                      mission_origin_x="{mission_origin_x}" mission_origin_y="{mission_origin_y}"
                                      field_size_m="{field_size_m}"/>
                <!-- param: post_check_rise_offset_m → {post_check_depth_offset_m} (負=浮上) -->
                <GoToDepth name="VisualPostCheck" depth_offset_m="{post_check_depth_offset_m}"/>
                <AlwaysFailure/>
              </Sequence>
            </Fallback>
          </RetryUntilSuccessful>
        </Timeout>
        <!-- mic_confirm_timeout_sec超過。旧flow.pyの_with_mic_confirm_timeoutと同じくEMERGENCYへ。 -->
        <SubTree ID="Emergency"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- 旧HOLD_TARGET(素通り) -> HYDRO_DIVE(dive_offset_m=2.5) -> [HYDRO_APPROACH/
       HYDRO_NEAR_SURFACE/HYDRO_CHECK_MIC ループ、mic_confirm_timeout_sec=45で束縛]。
       discovered_target(target_x/y/z)は親から引き継いだハイドロフォン発見時の値をそのまま使う
       (画像処理による再検出はしない、旧handle_hold_targetのコメントと同じ考え方)。 -->
  <BehaviorTree ID="HydroPath">
    <Sequence name="HydroDive">
      <!-- param: dive_offset_m -->
      <GoToDepth name="HydroDiveStep" depth_offset_m="{dive_offset_m}"/>
      <Fallback name="MicConfirmedOrEmergency">
        <!-- param: mic_confirm_timeout_sec → {mic_confirm_timeout_ms} -->
        <Timeout msec="{mic_confirm_timeout_ms}">
          <RetryUntilSuccessful num_attempts="-1">
            <Fallback name="CheckMicOrApproach">
              <Sequence name="MicConfirmed">
                <CheckRosBoolParam param_name="debug.mic_data_from_above" default_value="false"/>
                <SubTree ID="Surface"/>
              </Sequence>
              <Sequence name="ApproachAndCheck">
                <GoToBlackboardTarget name="HydroApproach"
                                      target_x="{target_x}" target_y="{target_y}" target_z="{target_z}"
                                      mission_origin_x="{mission_origin_x}" mission_origin_y="{mission_origin_y}"
                                      field_size_m="{field_size_m}"/>
                <!-- param: post_check_rise_offset_m → {post_check_depth_offset_m} (負=浮上) -->
                <GoToDepth name="HydroNearSurface" depth_offset_m="{post_check_depth_offset_m}"/>
                <AlwaysFailure/>
              </Sequence>
            </Fallback>
          </RetryUntilSuccessful>
        </Timeout>
        <SubTree ID="Emergency"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- 旧SURFACE(surface_rise_offset_m の相対浮上) -> RETURN_HOME -> DONE -->
  <BehaviorTree ID="Surface">
    <!-- param: surface_rise_offset_m → {surface_depth_offset_m} (負=浮上) -->
    <GoToDepth name="SurfaceStep" depth_offset_m="{surface_depth_offset_m}"/>
  </BehaviorTree>

  <!-- 旧DESCEND_TO_7M -> SEARCH_HYDROPHONE(search_timeout_sec) -> VISUAL/HYDRO 分岐 -->
  <BehaviorTree ID="Auto">
    <Timeout msec="{overall_mission_timeout_ms}" name="OverallMissionTimeout">
      <Sequence name="AutoSequence">
        <LifecycleManager name="ActivateZOHNode"
                          node_name="planner/wrench_planner/zoh_wrench_planner_component"
                          transition="activate"
                          timeout_sec="1"/>
        <Talker name="AutoTalker"
                message="Descending to depth"
                topic_name="/talker"/>
        <!-- param: descend_depth_m (launch depth_target_m で default_depth_m 上書き可) -->
        <GoToDepth name="DescendTo7m"/>
        <Fallback name="FoundOrSearchTimeoutSurface">
          <Sequence name="FoundAndDispatch">
            <!-- param: search_timeout_sec → {search_timeout_ms} -->
            <Timeout msec="{search_timeout_ms}">
              <CheckPingerFound pitch_threshold_deg="30.0"
                                score_threshold="1.0e6"
                                target_x="{target_x}"
                                target_y="{target_y}"
                                target_z="{target_z}"/>
            </Timeout>
            <Fallback name="VisualOrHydro">
              <Sequence name="TryVisual">
                <CheckRosBoolParam param_name="debug.image_processing_available"
                                   default_value="true"/>
                <SubTree ID="VisualPath"
                        target_x="{target_x}" target_y="{target_y}" target_z="{target_z}"/>
              </Sequence>
              <SubTree ID="HydroPath"
                      target_x="{target_x}" target_y="{target_y}" target_z="{target_z}"/>
            </Fallback>
          </Sequence>
          <!-- search_timeout_sec(7分)超過。旧flow.pyと同じくSURFACE(EMERGENCYではない)。 -->
          <SubTree ID="Surface"/>
        </Fallback>
      </Sequence>
    </Timeout>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <Sequence name="MainTreeSequence">
      <SubTree ID="InitMission"/>
      <!-- param: init_wait_sec → {init_wait_ms} (旧 INIT: センサー・ドライバ安定化の初期化待機) -->
      <Delay delay_msec="{init_wait_ms}">
        <Fallback name="MainFallback">
          <Sequence name="NormalSequence">
            <!-- param: origin_capture_timeout_sec → {origin_capture_timeout_ms}
                 フィールド境界判定(GoToBlackboardTarget)の原点をodomから確定する。
                 CaptureMissionOrigin自体は個別タイムアウトを持たないためTimeoutで包む
                 (DVLが一度もNORMALにならない場合、無期限RUNNINGしないようにする)。 -->
            <Timeout msec="{origin_capture_timeout_ms}">
              <CaptureMissionOrigin/>
            </Timeout>
            <SubTree ID="Configure"/>
            <SubTree ID="Auto"/>
          </Sequence>
          <SubTree ID="Emergency"/>
        </Fallback>
      </Delay>
    </Sequence>
  </BehaviorTree>

  <!-- ==================== 個別テスト用エントリポイント ====================
       main_tree_id launch引数でこれらのいずれかを直接rootとして起動できる。
       Configureとzoh activateを行った上で、対象SubTreeだけをテストする。
       discovered_target(target_x/y/z)はダミー座標をSetBlackboardで注入する
       (実機テストでは水深・水平方向とも近距離の安全な値にすること)。 -->

  <BehaviorTree ID="MainTree_SearchOnly">
    <Sequence>
      <SubTree ID="InitMission"/>
      <SubTree ID="Configure"/>
      <LifecycleManager name="ActivateZOHNodeTest"
                        node_name="planner/wrench_planner/zoh_wrench_planner_component"
                        transition="activate"
                        timeout_sec="1"/>
      <!-- param: search_timeout_sec → {search_timeout_ms} -->
      <Timeout msec="{search_timeout_ms}">
        <CheckPingerFound pitch_threshold_deg="30.0"
                          score_threshold="1.0e6"
                          target_x="{target_x}" target_y="{target_y}" target_z="{target_z}"/>
      </Timeout>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MainTree_VisualPath">
    <Sequence>
      <SubTree ID="InitMission"/>
      <SubTree ID="Configure"/>
      <LifecycleManager name="ActivateZOHNodeTest"
                        node_name="planner/wrench_planner/zoh_wrench_planner_component"
                        transition="activate"
                        timeout_sec="1"/>
      <!-- param: origin_capture_timeout_sec → {origin_capture_timeout_ms}
           GoToBlackboardTargetの境界チェックに使う原点を実際のodomから確定する
           (本番のMainTreeと同じ経路をテストするため、原点自体はダミーにしない)。 -->
      <Timeout msec="{origin_capture_timeout_ms}">
        <CaptureMissionOrigin/>
      </Timeout>
      <!-- target_x/yはmission_origin_x/yそのものを注入する(=境界矩形の原点隅と一致するため
           必ず境界チェックを通る)。固定座標(例えば0.0)にすると、テスト開始時の機体の
           実際の位置次第で境界チェックが意図せずFAILUREになりうるため避けている。
           境界チェックのFAILURE自体を確認したい場合は、value属性をmission_origin_x/yから
           大きく離れた値に変更すること。 -->
      <SetBlackboard value="{mission_origin_x}" output_key="target_x"/>
      <SetBlackboard value="{mission_origin_y}" output_key="target_y"/>
      <SetBlackboard value="1.0" output_key="target_z"/>
      <SubTree ID="VisualPath" target_x="{target_x}" target_y="{target_y}" target_z="{target_z}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MainTree_HydroPath">
    <Sequence>
      <SubTree ID="InitMission"/>
      <SubTree ID="Configure"/>
      <LifecycleManager name="ActivateZOHNodeTest"
                        node_name="planner/wrench_planner/zoh_wrench_planner_component"
                        transition="activate"
                        timeout_sec="1"/>
      <!-- param: origin_capture_timeout_sec → {origin_capture_timeout_ms}
           GoToBlackboardTargetの境界チェックに使う原点を実際のodomから確定する
           (本番のMainTreeと同じ経路をテストするため、原点自体はダミーにしない)。 -->
      <Timeout msec="{origin_capture_timeout_ms}">
        <CaptureMissionOrigin/>
      </Timeout>
      <!-- target_x/yはmission_origin_x/yそのものを注入する(=境界矩形の原点隅と一致するため
           必ず境界チェックを通る)。固定座標(例えば0.0)にすると、テスト開始時の機体の
           実際の位置次第で境界チェックが意図せずFAILUREになりうるため避けている。
           境界チェックのFAILURE自体を確認したい場合は、value属性をmission_origin_x/yから
           大きく離れた値に変更すること。 -->
      <SetBlackboard value="{mission_origin_x}" output_key="target_x"/>
      <SetBlackboard value="{mission_origin_y}" output_key="target_y"/>
      <SetBlackboard value="1.0" output_key="target_z"/>
      <SubTree ID="HydroPath" target_x="{target_x}" target_y="{target_y}" target_z="{target_z}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MainTree_Surface">
    <Sequence>
      <SubTree ID="InitMission"/>
      <SubTree ID="Configure"/>
      <LifecycleManager name="ActivateZOHNodeTest"
                        node_name="planner/wrench_planner/zoh_wrench_planner_component"
                        transition="activate"
                        timeout_sec="1"/>
      <SubTree ID="Surface"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="GoToDepth"
            editable="true">
      <input_port name="depth_absolute_m"/>
      <input_port name="depth_offset_m"/>
      <input_port name="tolerance_m"
                  default="0.1"/>
      <input_port name="topic_name"
                  default="zoh_wrench_plan"/>
      <input_port name="odom_topic_name"
                  default="odom"/>
    </Action>
    <Action ID="GoToBlackboardTarget"
            editable="true">
      <input_port name="target_x"/>
      <input_port name="target_y"/>
      <input_port name="target_z"/>
      <input_port name="position_tolerance_m"
                  default="0.2"/>
      <input_port name="depth_tolerance_m"
                  default="0.1"/>
      <input_port name="topic_name"
                  default="zoh_wrench_plan"/>
      <input_port name="odom_topic_name"
                  default="odom"/>
      <input_port name="mission_origin_x"/>
      <input_port name="mission_origin_y"/>
      <input_port name="field_size_m"
                  default="10.0"/>
    </Action>
    <Action ID="CheckPingerFound"
            editable="true">
      <input_port name="pinger_direction_topic"
                  default="pinger_direction"/>
      <input_port name="wrench_plan_topic"
                  default="zoh_wrench_plan"/>
      <input_port name="pitch_threshold_deg"
                  default="30.0"/>
      <input_port name="score_threshold"
                  default="1.0e6"/>
      <output_port name="target_x"/>
      <output_port name="target_y"/>
      <output_port name="target_z"/>
    </Action>
    <Action ID="CheckBuoyDetected"
            editable="true">
      <input_port name="buoy_detection_topic"
                  default="buoy_detection"/>
      <input_port name="odom_topic_name"
                  default="odom"/>
      <input_port name="confidence_threshold"
                  default="0.5"/>
      <input_port name="stale_timeout_sec"
                  default="1.0"/>
      <output_port name="target_x"/>
      <output_port name="target_y"/>
      <output_port name="target_z"/>
    </Action>
    <Condition ID="CheckRosBoolParam"
               editable="true">
      <input_port name="param_name"/>
      <input_port name="default_value"
                  default="true"/>
    </Condition>
    <Action ID="LoadMissionParams"
            editable="true">
      <description>config/bluerov_mission.param.yaml をブラックボードへ載せる</description>
    </Action>
    <Action ID="CaptureMissionOrigin"
            editable="true">
      <input_port name="odom_topic_name"
                  default="odom"/>
      <description>status.dvl.id == NORMAL のodomを受信するまで待機し、mission_origin_x/yを
      ブラックボードへ確定する(GoToBlackboardTargetのフィールド境界チェックの原点)</description>
    </Action>
  </TreeNodesModel>

</root>
