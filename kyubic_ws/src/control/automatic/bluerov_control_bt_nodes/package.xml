<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerov_control_bt_nodes</name>
  <version>0.1.0</version>
  <description>
    BlueROV-specific Behavior Tree leaf nodes for reuse with Kyubic's bt_executor
    (behavior_tree package). Phase 1: SetDepthTarget only (publish a one-shot absolute
    depth WrenchPlan target, holding current x/y/roll/yaw).
  </description>
  <maintainer email="kyutech.robosub@gmail.com">Kyutech Underwater</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>planner_msgs</depend>
  <depend>localization_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
