<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bluerov_control</name>
  <version>0.1.0</version>
  <description>BlueROV mission state-machine control node (INIT to SURFACE), ported from the standalone blueRovControl scripts.</description>
  <maintainer email="kyutech.robosub@gmail.com">Kyutech Underwater</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>localization_msgs</depend>
  <depend>driver_msgs</depend>
  <depend>bluerov_control_msgs</depend>
  <depend>planner_msgs</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
