<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dvl75_driver</name>
  <version>0.1.0</version>
  <description>Cerulean Sonar DVL-75 driver for BlueROV.</description>
  <maintainer email="kyutech.robosub@gmail.com">Kyutech Underwater</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>blue_rov_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>common_msgs</depend>
  <depend>custom_socket</depend>
  <depend>driver_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_clang_format</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
